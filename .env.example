# ── Google Gemini ──────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── Gmail (use an App Password, NOT your main password) ────
# Guide: https://support.google.com/accounts/answer/185833
GMAIL_APP_PASSWORD=your_16_char_app_password
GMAIL_FROM=your_email@gmail.com

# ── RapidAPI key for JSearch — the main job source ─────────
# 1. Create a RapidAPI account: https://rapidapi.com
# 2. Subscribe to JSearch (free tier available):
#    https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
# 3. Copy your key from the API playground (X-RapidAPI-Key)
RAPIDAPI_KEY=your_rapidapi_key

# ── App Settings ───────────────────────────────────────────
SCAN_INTERVAL_HOURS=6
MAX_JOBS_PER_SCAN=50

# ── Daily digest email (sent after each scheduled scan) ────
DIGEST_ENABLED=true
DIGEST_TO=                       # defaults to GMAIL_FROM
FRONTEND_URL=http://localhost:3000
