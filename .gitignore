# ── Secrets / personal data ───────────────────────────────────
.env
.env.local
profile/profile.json

# ── Python ─────────────────────────────────────────────────
.venv/
__pycache__/
*.pyc
*.pyo

# ── Runtime data (regenerated by the app) ────────────────────
data/jobhunter.db
data/generated/
data/settings.json

# ── Node / Next.js (frontend has its own .gitignore too) ────
frontend/node_modules/
frontend/.next/

# ── Editor / OS ───────────────────────────────────────────────
.DS_Store
.vscode/
*.swp

# ── Claude Code local settings (machine-specific) ────────────
.claude/settings.local.json
