# ── Secrets / personal data ───────────────────────────────────
.env
.env.local
profile/profile.json

# ── Python ─────────────────────────────────────────────────
.venv/
__pycache__/
*.pyc
*.pyo

# ── Runtime data (regenerated by the app) ────────────────────
data/jobhunter.db
data/generated/
data/settings.json
data/llm_budget.json
data/source_cursors.json
data/preferences.json

# ── Node / Next.js (frontend has its own .gitignore too) ────
frontend/node_modules/
frontend/.next/

# ── Packaged builds (regenerated by build_exe.ps1) ───────────
backend/dist/
backend/build/
mac_bundle/
*.spec.bak

# ── Editor / OS ───────────────────────────────────────────────
.DS_Store
.vscode/
*.swp

# ── Personal working files (not part of the app) ─────────────
Claude outputs/
docs/REFACTOR_PLAN.md
docs/HANDOFF_PROMPTS.md

# ── Claude Code local settings (machine-specific) ────────────
.claude/settings.local.json
